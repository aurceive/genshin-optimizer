{
  "suiteId": "public-bounded-exact-v0.2",
  "suiteClass": "public",
  "corpusVersion": "0.2.0",
  "description": "Public correctness and performance suite for bounded-exact optimization — GI artifact scenarios from golden-oracle to large-scale.",
